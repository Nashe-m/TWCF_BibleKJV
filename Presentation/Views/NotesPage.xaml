<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TWCF_BibleApp.Presentation.Views.NotesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Notes">

    <!-- Filled in with the list in Phase 4; until then only the empty state shows. -->
    <Grid RowDefinitions="Auto,*" Padding="32,28,32,0" MaximumWidthRequest="900">
        <Label Text="Notes" Style="{StaticResource PageTitleLabel}" />

        <VerticalStackLayout Grid.Row="1"
                             Spacing="10"
                             MaximumWidthRequest="420"
                             VerticalOptions="Center"
                             Margin="0,0,0,80">
            <Label Text="&#xE70B;" Style="{StaticResource EmptyStateIcon}" />
            <Label Text="No notes yet" Style="{StaticResource EmptyStateTitle}" />
            <Label Text="Select a verse in the reader and choose Note to write down a thought, a sermon point or a prayer. Your notes will be listed here." Style="{StaticResource EmptyStateText}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
