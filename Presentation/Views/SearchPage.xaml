<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    x:Class="TWCF_BibleApp.Presentation.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Search Bible"
    BackgroundColor="{DynamicResource PageBackgroundColor}">

    <VerticalStackLayout Padding="20" Spacing="16">

        <!--Search bar-->
        <Entry 
            Placeholder="Search..."
            Text="{Binding SearchQuery}" 
            ReturnType="Search" 
            Completed="OnSearchCompleted" />

        <Button 
            Text="Search"
            Command="{Binding PerformSearchCommand}" />

        <!-- Search results -->
        <CollectionView 
            ItemsSource="{Binding SearchResults}" 
            SelectionMode="Single"
            SelectedItem="{Binding SelectedResult, Mode=TwoWay}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="8" Spacing="4">
                        <Label Text="{Binding Reference}" FontAttributes="Bold" />
                        <Label Text="{Binding Text}" LineHeight="1.4" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>