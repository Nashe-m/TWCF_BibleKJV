<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:TWCF_BibleApp.Presentation.ViewModels"
    xmlns:dto="clr-namespace:TWCF_BibleApp.Application.DTOs"
    xmlns:comp="clr-namespace:TWCF_BibleApp.Presentation.Components"
    x:Class="TWCF_BibleApp.Presentation.Views.ReaderPage"
    x:Name="Root"
    x:DataType="vm:ReaderViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource PageBackgroundColor}">

    <ContentPage.Resources>
        <!-- Sidebar book row -->
        <DataTemplate x:Key="BookTemplate" x:DataType="vm:BookNavItem">
            <VerticalStackLayout Spacing="6">
                <Border StrokeThickness="0"
                        Padding="14,9"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="Transparent">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource AccentSoftColor}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectBookCommand, Source={RelativeSource AncestorType={x:Type vm:ReaderViewModel}}, x:DataType=vm:ReaderViewModel}"
                                              CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding DisplayName}" FontSize="15">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="TextColor" Value="{DynamicResource AccentColor}" />
                                <Setter Property="FontAttributes" Value="Bold" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>

                <!-- Chapter grid for the selected book -->
                <FlexLayout IsVisible="{Binding IsSelected}"
                            Wrap="Wrap"
                            Direction="Row"
                            JustifyContent="Start"
                            AlignContent="Start"
                            Margin="6,0,0,8"
                            BindableLayout.ItemsSource="{Binding Chapters}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChapterNavItem">
                            <Border WidthRequest="40"
                                    HeightRequest="34"
                                    Margin="0,0,5,5"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 7"
                                    BackgroundColor="{DynamicResource ChipColor}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsCurrent}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource AccentColor}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectChapterCommand, Source={RelativeSource AncestorType={x:Type vm:ReaderViewModel}}, x:DataType=vm:ReaderViewModel}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Number}"
                                       FontSize="13"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource AccentTextColor}" />
                                            <Setter Property="FontAttributes" Value="Bold" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- ============ TOP BAR ============ -->
        <Grid Grid.Row="0"
              IsVisible="{Binding IsChromeVisible}"
              BackgroundColor="{DynamicResource SurfaceColor}"
              Padding="16,12"
              ColumnDefinitions="Auto,Auto,Auto,*,Auto"
              ColumnSpacing="10">

            <HorizontalStackLayout Grid.Column="0" Spacing="2">
                <Button Style="{StaticResource IconButton}" Text="&#xE700;"
                        Command="{Binding ToggleSidebarCommand}"
                        ToolTipProperties.Text="Show or hide books (Ctrl+B)" />
                <Button Style="{StaticResource IconButton}" Text="&#xE76B;"
                        Command="{Binding PreviousChapterCommand}"
                        ToolTipProperties.Text="Previous chapter (Left arrow)" />
                <Button Style="{StaticResource IconButton}" Text="&#xE76C;"
                        Command="{Binding NextChapterCommand}"
                        ToolTipProperties.Text="Next chapter (Right arrow)" />
            </HorizontalStackLayout>

            <Button Grid.Column="1"
                    Style="{StaticResource OutlineButton}"
                    Text="{Binding LocationLabel}"
                    Command="{Binding ToggleSidebarCommand}" />

            <Picker Grid.Column="2"
                    ItemsSource="{Binding Translations}"
                    ItemDisplayBinding="{Binding DisplayName, x:DataType=dto:TranslationDto}"
                    SelectedItem="{Binding SelectedTranslation, Mode=TwoWay}"
                    WidthRequest="240"
                    VerticalOptions="Center"
                    FontSize="15"
                    TextColor="{DynamicResource PageTextColor}"
                    BackgroundColor="{DynamicResource SurfaceColor}"
                    ToolTipProperties.Text="Bible version" />

            <!-- Search / jump to reference -->
            <Border x:Name="SearchBox"
                    Grid.Column="3"
                    MaximumWidthRequest="560"
                    HeightRequest="42"
                    Padding="14,0,8,0"
                    StrokeThickness="1"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{DynamicResource ChipColor}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Label Text="&#xE721;"
                           FontFamily="{StaticResource IconFont}"
                           FontSize="15"
                           TextColor="{DynamicResource MutedTextColor}"
                           VerticalOptions="Center" />
                    <Entry x:Name="SearchEntry"
                           Grid.Column="1"
                           Text="{Binding SearchText, Mode=TwoWay}"
                           Placeholder="Search or go to (e.g. Jn 3:16)"
                           PlaceholderColor="{DynamicResource MutedTextColor}"
                           TextColor="{DynamicResource PageTextColor}"
                           BackgroundColor="Transparent"
                           FontSize="15"
                           ReturnType="Search"
                           ReturnCommand="{Binding SubmitSearchCommand}"
                           Focused="SearchEntry_Focused"
                           Unfocused="SearchEntry_Unfocused"
                           VerticalOptions="Center" />
                    <Border Grid.Column="2"
                            Padding="8,3"
                            StrokeThickness="1"
                            Stroke="{DynamicResource BorderColor}"
                            StrokeShape="RoundRectangle 6"
                            VerticalOptions="Center">
                        <Label Text="Ctrl K" FontSize="11" TextColor="{DynamicResource MutedTextColor}" />
                    </Border>
                </Grid>
            </Border>

            <HorizontalStackLayout Grid.Column="4" Spacing="4">
                <!-- Font size -->
                <Border Padding="2"
                        StrokeThickness="1"
                        Stroke="{DynamicResource BorderColor}"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="{DynamicResource SurfaceColor}">
                    <HorizontalStackLayout>
                        <Button Style="{StaticResource IconButton}" Text="&#xE8E7;"
                                Command="{Binding DecreaseFontCommand}"
                                ToolTipProperties.Text="Smaller text (Ctrl+Minus)" />
                        <Label Text="{Binding FontSizeLabel}"
                               WidthRequest="56"
                               FontSize="13"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ResetFontCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Button Style="{StaticResource IconButton}" Text="&#xE8E8;"
                                Command="{Binding IncreaseFontCommand}"
                                ToolTipProperties.Text="Larger text (Ctrl+Plus)" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Red letter on/off; greyed out for versions without the markup -->
                <Button Style="{StaticResource OutlineButton}"
                        Text="Red letter"
                        FontSize="14"
                        Padding="12,0"
                        Margin="4,0,0,0"
                        TextColor="{DynamicResource MutedTextColor}"
                        IsEnabled="{Binding HasWordsOfJesus}"
                        Command="{Binding ToggleWordsOfJesusCommand}"
                        ToolTipProperties.Text="Words of Jesus in red (Ctrl+R). Available in KJV and WEB.">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ShowWordsOfJesus}" Value="True">
                            <Setter Property="TextColor" Value="{DynamicResource WordsOfJesusColor}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding HasWordsOfJesus}" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Button Style="{StaticResource IconButton}"
                        Text="{Binding ThemeGlyph}"
                        Command="{Binding ToggleThemeCommand}"
                        ToolTipProperties.Text="Light / dark (Ctrl+D)" />

                <Button Style="{StaticResource AccentButton}"
                        Text="Present"
                        Margin="6,0,0,0"
                        Command="{Binding ToggleProjectorCommand}"
                        ToolTipProperties.Text="Full-screen projector view (F5)" />
            </HorizontalStackLayout>

            <BoxView Grid.ColumnSpan="5"
                     HeightRequest="1"
                     Margin="-16,0,-16,-12"
                     VerticalOptions="End"
                     Color="{DynamicResource BorderColor}" />
        </Grid>

        <!-- ============ BODY ============ -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">

            <!-- Sidebar -->
            <Grid Grid.Column="0"
                  WidthRequest="290"
                  IsVisible="{Binding IsSidebarVisible}"
                  BackgroundColor="{DynamicResource SurfaceColor}">
                <ScrollView x:Name="SidebarScroll">
                    <VerticalStackLayout Padding="16,20" Spacing="2">
                        <Label Text="OLD TESTAMENT" Style="{StaticResource SectionHeaderLabel}" Margin="12,0,0,8" />
                        <VerticalStackLayout x:Name="OldTestamentList"
                                             Spacing="2"
                                             BindableLayout.ItemsSource="{Binding OldTestamentBooks}"
                                             BindableLayout.ItemTemplate="{StaticResource BookTemplate}" />

                        <Label Text="NEW TESTAMENT" Style="{StaticResource SectionHeaderLabel}" Margin="12,24,0,8" />
                        <VerticalStackLayout x:Name="NewTestamentList"
                                             Spacing="2"
                                             BindableLayout.ItemsSource="{Binding NewTestamentBooks}"
                                             BindableLayout.ItemTemplate="{StaticResource BookTemplate}" />
                    </VerticalStackLayout>
                </ScrollView>
                <BoxView WidthRequest="1" HorizontalOptions="End" Color="{DynamicResource BorderColor}" />
            </Grid>

            <!-- Reading column -->
            <ScrollView x:Name="ReadingScroll" Grid.Column="1">
                <VerticalStackLayout Padding="{Binding ReadingPadding}"
                                     MaximumWidthRequest="{Binding ReadingColumnWidth}"
                                     HorizontalOptions="Center"
                                     Spacing="0">

                    <Label Text="{Binding TestamentLabel}"
                           Style="{StaticResource SectionHeaderLabel}"
                           FontSize="13" />

                    <Label Text="{Binding ChapterTitle}"
                           FontFamily="{StaticResource ScriptureFont}"
                           FontSize="{Binding ChapterTitleFontSize}"
                           FontAttributes="Bold"
                           Margin="0,4,0,24" />

                    <VerticalStackLayout x:Name="VersesLayout"
                                         Spacing="{Binding VerseSpacing}"
                                         BindableLayout.ItemsSource="{Binding Verses}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:VerseItem">
                                <Border StrokeThickness="0"
                                        Padding="10,4"
                                        Margin="-10,0"
                                        StrokeShape="RoundRectangle 8"
                                        BackgroundColor="Transparent">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsTarget}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource AccentSoftColor}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <comp:VerseLabel Verse="{Binding .}"
                                                     FontFamily="{StaticResource ScriptureFont}"
                                                     FontSize="{Binding ReadingFontSize, Source={RelativeSource AncestorType={x:Type vm:ReaderViewModel}}, x:DataType=vm:ReaderViewModel}"
                                                     NumberFontSize="{Binding VerseNumberFontSize, Source={RelativeSource AncestorType={x:Type vm:ReaderViewModel}}, x:DataType=vm:ReaderViewModel}"
                                                     ShowWordsOfJesus="{Binding ShowWordsOfJesus, Source={RelativeSource AncestorType={x:Type vm:ReaderViewModel}}, x:DataType=vm:ReaderViewModel}"
                                                     LineHeight="1.45" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Previous / next chapter -->
                    <BoxView HeightRequest="1" Margin="0,48,0,12" Color="{DynamicResource BorderColor}" />
                    <Grid ColumnDefinitions="*,*" IsVisible="{Binding IsChromeVisible}">
                        <Button Style="{StaticResource LinkButton}"
                                Text="{Binding PreviousLabel}"
                                HorizontalOptions="Start"
                                Command="{Binding PreviousChapterCommand}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource LinkButton}"
                                Text="{Binding NextLabel}"
                                HorizontalOptions="End"
                                Command="{Binding NextChapterCommand}" />
                    </Grid>

                    <!-- Attribution required by some licences (e.g. Shona, CC BY-SA) -->
                    <Label Text="{Binding SelectedTranslation.Copyright}"
                           FontSize="12"
                           Margin="0,16,0,0"
                           HorizontalTextAlignment="Center"
                           TextColor="{DynamicResource MutedTextColor}" />
                </VerticalStackLayout>
            </ScrollView>

            <!-- Projector mode controls: faint until hovered so they don't distract -->
            <Border x:Name="ProjectorControls"
                    Grid.Column="1"
                    IsVisible="{Binding IsProjectorMode}"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="24"
                    Padding="6"
                    Opacity="0.35"
                    StrokeThickness="1"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{DynamicResource SurfaceColor}">
                <Border.GestureRecognizers>
                    <PointerGestureRecognizer PointerEntered="ProjectorControls_PointerEntered"
                                              PointerExited="ProjectorControls_PointerExited" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="2">
                    <Button Style="{StaticResource IconButton}" Text="&#xE76B;" Command="{Binding PreviousChapterCommand}" ToolTipProperties.Text="Previous chapter" />
                    <Button Style="{StaticResource IconButton}" Text="&#xE76C;" Command="{Binding NextChapterCommand}" ToolTipProperties.Text="Next chapter" />
                    <Button Style="{StaticResource IconButton}" Text="&#xE8E7;" Command="{Binding DecreaseFontCommand}" ToolTipProperties.Text="Smaller text" />
                    <Label Text="{Binding FontSizeLabel}" WidthRequest="56" FontSize="13" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                    <Button Style="{StaticResource IconButton}" Text="&#xE8E8;" Command="{Binding IncreaseFontCommand}" ToolTipProperties.Text="Larger text" />
                    <Button Style="{StaticResource IconButton}" Text="{Binding ThemeGlyph}" Command="{Binding ToggleThemeCommand}" ToolTipProperties.Text="Light / dark" />
                    <Button Style="{StaticResource IconButton}" Text="&#xE73F;" Command="{Binding ExitProjectorCommand}" ToolTipProperties.Text="Exit (Esc)" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- ============ SEARCH DROPDOWN ============ -->
        <!-- Overlays the page under the search box; positioned in code-behind to line up with it. -->
        <Border x:Name="SuggestionsPanel"
                Grid.Row="1"
                IsVisible="{Binding IsSuggestionsOpen}"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                Margin="0,6,0,0"
                Padding="6"
                StrokeThickness="1"
                Stroke="{DynamicResource BorderColor}"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="{DynamicResource SurfaceColor}">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,6" Radius="18" Opacity="0.18" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="2">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Suggestions}" Spacing="2">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:SearchSuggestion">
                            <Border StrokeThickness="0"
                                    Padding="12,8"
                                    StrokeShape="RoundRectangle 8"
                                    BackgroundColor="Transparent">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenSuggestionCommand, Source={RelativeSource AncestorType={x:Type vm:ReaderViewModel}}, x:DataType=vm:ReaderViewModel}"
                                                          CommandParameter="{Binding .}" />
                                    <PointerGestureRecognizer PointerEntered="Suggestion_PointerEntered"
                                                              PointerExited="Suggestion_PointerExited" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="2">
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Text="&#xE8AD;"
                                               IsVisible="{Binding IsReference}"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="14"
                                               TextColor="{DynamicResource AccentColor}"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding Title}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource PageTextColor}" />
                                    </HorizontalStackLayout>
                                    <comp:HighlightedLabel MarkedText="{Binding HighlightedText}"
                                                           IsVisible="{Binding IsMatch}"
                                                           FontSize="14"
                                                           MaxLines="2"
                                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="No verses match"
                       IsVisible="{Binding HasNoSuggestions}"
                       Padding="12,8"
                       FontSize="14"
                       TextColor="{DynamicResource MutedTextColor}" />

                <BoxView HeightRequest="1" Margin="6,4" Color="{DynamicResource BorderColor}" IsVisible="{Binding HasMoreResults}" />
                <Button Style="{StaticResource LinkButton}"
                        Text="{Binding SeeAllLabel}"
                        IsVisible="{Binding HasMoreResults}"
                        HorizontalOptions="Start"
                        FontSize="14"
                        Command="{Binding SeeAllResultsCommand}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
