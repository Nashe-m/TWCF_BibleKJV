<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:TWCF_BibleApp.Presentation.ViewModels"
    xmlns:dto="clr-namespace:TWCF_BibleApp.Application.DTOs"
    xmlns:comp="clr-namespace:TWCF_BibleApp.Presentation.Components"
    x:Class="TWCF_BibleApp.Presentation.Views.ReaderPage"
    x:Name="Root"
    x:DataType="vm:ReaderViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource PageBackgroundColor}">

    <ContentPage.Resources>
        <!-- Sidebar book row -->
        <DataTemplate x:Key="BookTemplate" x:DataType="vm:BookNavItem">
            <VerticalStackLayout Spacing="6">
                <Border StrokeThickness="0"
                        Padding="14,9"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="Transparent">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource AccentSoftColor}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectBookCommand, Source={RelativeSource AncestorType={x:Type vm:ReaderViewModel}}, x:DataType=vm:ReaderViewModel}"
                                              CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding DisplayName}" FontSize="15">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="TextColor" Value="{DynamicResource AccentColor}" />
                                <Setter Property="FontAttributes" Value="Bold" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>

                <!-- Chapter grid for the selected book -->
                <FlexLayout IsVisible="{Binding IsSelected}"
                            Wrap="Wrap"
                            Direction="Row"
                            JustifyContent="Start"
                            AlignContent="Start"
                            Margin="6,0,0,8"
                            BindableLayout.ItemsSource="{Binding Chapters}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChapterNavItem">
                            <Border WidthRequest="40"
                                    HeightRequest="34"
                                    Margin="0,0,5,5"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 7"
                                    BackgroundColor="{DynamicResource ChipColor}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsCurrent}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource AccentColor}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectChapterCommand, Source={RelativeSource AncestorType={x:Type vm:ReaderViewModel}}, x:DataType=vm:ReaderViewModel}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Number}"
                                       FontSize="13"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource AccentTextColor}" />
                                            <Setter Property="FontAttributes" Value="Bold" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- ============ TOP BAR ============ -->
        <!-- On a phone (IsNarrow) ReaderPage.xaml.cs moves the search box to the second row. -->
        <Grid x:Name="TopBar"
              Grid.Row="0"
              IsVisible="{Binding IsChromeVisible}"
              BackgroundColor="{DynamicResource SurfaceColor}"
              Padding="16,12"
              RowDefinitions="Auto,Auto"
              ColumnDefinitions="Auto,Auto,Auto,*,Auto"
              ColumnSpacing="10">

            <HorizontalStackLayout Grid.Column="0" Spacing="2">
                <Button Style="{StaticResource IconButton}" Text="&#xE700;"
                        Command="{Binding ToggleSidebarCommand}"
                        ToolTipProperties.Text="Show or hide books (Ctrl+B)" SemanticProperties.Description="Show or hide books" />
                <Button Style="{StaticResource IconButton}" Text="&#xE76B;"
                        IsVisible="{Binding IsFullToolbar}"
                        Command="{Binding PreviousChapterCommand}"
                        ToolTipProperties.Text="Previous chapter (Left arrow)" SemanticProperties.Description="Previous chapter" />
                <Button Style="{StaticResource IconButton}" Text="&#xE76C;"
                        IsVisible="{Binding IsFullToolbar}"
                        Command="{Binding NextChapterCommand}"
                        ToolTipProperties.Text="Next chapter (Right arrow)" SemanticProperties.Description="Next chapter" />
            </HorizontalStackLayout>

            <Button Grid.Column="1"
                    Style="{StaticResource OutlineButton}"
                    Text="{Binding LocationLabel}"
                    Command="{Binding ToggleSidebarCommand}" />

            <Picker x:Name="VersionPicker"
                    Grid.Column="2"
                    ItemsSource="{Binding Translations}"
                    ItemDisplayBinding="{Binding DisplayName, x:DataType=dto:TranslationDto}"
                    SelectedItem="{Binding SelectedTranslation, Mode=TwoWay}"
                    WidthRequest="{Binding VersionPickerWidth}"
                    VerticalOptions="Center"
                    FontSize="15"
                    TextColor="{DynamicResource PageTextColor}"
                    BackgroundColor="{DynamicResource SurfaceColor}"
                    ToolTipProperties.Text="Bible version" SemanticProperties.Description="Bible version" />

            <!-- Search / jump to reference -->
            <Border x:Name="SearchBox"
                    Grid.Column="3"
                    MaximumWidthRequest="560"
                    HeightRequest="42"
                    Padding="14,0,8,0"
                    StrokeThickness="1"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{DynamicResource ChipColor}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Label Text="&#xE721;"
                           FontFamily="{StaticResource IconFont}"
                           FontSize="15"
                           TextColor="{DynamicResource MutedTextColor}"
                           VerticalOptions="Center" />
                    <Entry x:Name="SearchEntry"
                           Grid.Column="1"
                           Text="{Binding SearchText, Mode=TwoWay}"
                           Placeholder="Search or go to (e.g. Jn 3:16)"
                           PlaceholderColor="{DynamicResource MutedTextColor}"
                           TextColor="{DynamicResource PageTextColor}"
                           BackgroundColor="Transparent"
                           FontSize="15"
                           ReturnType="Search"
                           ReturnCommand="{Binding SubmitSearchCommand}"
                           Focused="SearchEntry_Focused"
                           Unfocused="SearchEntry_Unfocused"
                           VerticalOptions="Center" />
                    <Border Grid.Column="2"
                            Padding="8,3"
                            StrokeThickness="1"
                            Stroke="{DynamicResource BorderColor}"
                            StrokeShape="RoundRectangle 6"
                            VerticalOptions="Center">
                        <Label Text="Ctrl K" FontSize="11" TextColor="{DynamicResource MutedTextColor}" />
                    </Border>
                </Grid>
            </Border>

            <HorizontalStackLayout Grid.Column="4" Spacing="4">
                <!-- Font size -->
                <Border IsVisible="{Binding IsInlineDisplayControlsVisible}"
                        Padding="2"
                        StrokeThickness="1"
                        Stroke="{DynamicResource BorderColor}"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="{DynamicResource SurfaceColor}">
                    <HorizontalStackLayout>
                        <Button Style="{StaticResource IconButton}" Text="&#xE8E7;"
                                Command="{Binding DecreaseFontCommand}"
                                ToolTipProperties.Text="Smaller text (Ctrl+Minus)" SemanticProperties.Description="Smaller text" />
                        <Label Text="{Binding FontSizeLabel}"
                               WidthRequest="56"
                               FontSize="13"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ResetFontCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Button Style="{StaticResource IconButton}" Text="&#xE8E8;"
                                Command="{Binding IncreaseFontCommand}"
                                ToolTipProperties.Text="Larger text (Ctrl+Plus)" SemanticProperties.Description="Larger text" />
                    </HorizontalStackLayout>
                </Border>

                <Button Style="{StaticResource IconButton}"
                        IsVisible="{Binding IsInlineDisplayControlsVisible}"
                        Text="{Binding ThemeGlyph}"
                        Command="{Binding ToggleThemeCommand}"
                        ToolTipProperties.Text="Light / dark (Ctrl+D)" SemanticProperties.Description="Light / dark" />

                <!-- On smaller screens text size and theme live in this menu -->
                <Button Style="{StaticResource OutlineButton}"
                        IsVisible="{Binding IsCompact}"
                        Text="Aa"
                        FontFamily="{StaticResource ScriptureFont}"
                        FontSize="17"
                        Padding="12,0"
                        Command="{Binding ToggleDisplayMenuCommand}"
                        ToolTipProperties.Text="Text size and theme" SemanticProperties.Description="Text size and theme" />

                <Button Style="{StaticResource AccentButton}"
                        IsVisible="{Binding IsFullToolbar}"
                        Text="Present"
                        Margin="6,0,0,0"
                        Command="{Binding ToggleProjectorCommand}"
                        ToolTipProperties.Text="Full-screen projector view (F5)" SemanticProperties.Description="Full-screen projector view" />
            </HorizontalStackLayout>

            <BoxView Grid.ColumnSpan="5"
                     Grid.RowSpan="2"
                     HeightRequest="1"
                     Margin="-16,0,-16,-12"
                     VerticalOptions="End"
                     Color="{DynamicResource BorderColor}" />
        </Grid>

        <!-- ============ BODY ============ -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">

            <!-- Dims the text behind the book drawer; tap to close -->
            <BoxView Grid.Column="1"
                     ZIndex="1"
                     IsVisible="{Binding IsDrawerOpen}"
                     Color="Black"
                     Opacity="0.35">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseOverlaysCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <!-- Sidebar: docked in column 0 on wide screens, a drawer over column 1 otherwise -->
            <Grid x:Name="Sidebar"
                  Grid.Column="0"
                  ZIndex="2"
                  WidthRequest="290"
                  IsVisible="{Binding IsSidebarVisible}"
                  BackgroundColor="{DynamicResource SurfaceColor}">
                <ScrollView x:Name="SidebarScroll">
                    <VerticalStackLayout Padding="16,20" Spacing="2">
                        <Label Text="OLD TESTAMENT" Style="{StaticResource SectionHeaderLabel}" Margin="12,0,0,8" />
                        <VerticalStackLayout x:Name="OldTestamentList"
                                             Spacing="2"
                                             BindableLayout.ItemsSource="{Binding OldTestamentBooks}"
                                             BindableLayout.ItemTemplate="{StaticResource BookTemplate}" />

                        <Label Text="NEW TESTAMENT" Style="{StaticResource SectionHeaderLabel}" Margin="12,24,0,8" />
                        <VerticalStackLayout x:Name="NewTestamentList"
                                             Spacing="2"
                                             BindableLayout.ItemsSource="{Binding NewTestamentBooks}"
                                             BindableLayout.ItemTemplate="{StaticResource BookTemplate}" />
                    </VerticalStackLayout>
                </ScrollView>
                <BoxView WidthRequest="1" HorizontalOptions="End" Color="{DynamicResource BorderColor}" />
            </Grid>

            <!-- Reading column -->
            <ScrollView x:Name="ReadingScroll" Grid.Column="1">
                <VerticalStackLayout Padding="{Binding ReadingPadding}"
                                     MaximumWidthRequest="{Binding ReadingColumnWidth}"
                                     HorizontalOptions="Center"
                                     Spacing="0">

                    <Label Text="{Binding TestamentLabel}"
                           Style="{StaticResource SectionHeaderLabel}"
                           FontSize="13" />

                    <Label Text="{Binding ChapterTitle}"
                           FontFamily="{StaticResource ScriptureFont}"
                           FontSize="{Binding ChapterTitleFontSize}"
                           FontAttributes="Bold"
                           Margin="0,4,0,24" />

                    <VerticalStackLayout x:Name="VersesLayout"
                                         SizeChanged="VersesLayout_SizeChanged"
                                         Spacing="{Binding VerseSpacing}"
                                         BindableLayout.ItemsSource="{Binding Verses}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:VerseItem">
                                <!-- Background: highlight colour (or the jump target); outline: selected -->
                                <Border StrokeThickness="2"
                                        Stroke="Transparent"
                                        Padding="10,4"
                                        Margin="-10,0"
                                        StrokeShape="RoundRectangle 8"
                                        BackgroundColor="{Binding HighlightColor}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="Verse_Tapped" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <!-- The jump marker never hides the user's own highlight -->
                                        <MultiTrigger TargetType="Border">
                                            <MultiTrigger.Conditions>
                                                <BindingCondition Binding="{Binding IsTarget}" Value="True" />
                                                <BindingCondition Binding="{Binding HasHighlight}" Value="False" />
                                            </MultiTrigger.Conditions>
                                            <Setter Property="BackgroundColor" Value="{DynamicResource AccentSoftColor}" />
                                        </MultiTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Stroke" Value="{DynamicResource AccentColor}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <comp:VerseLabel Verse="{Binding .}"
                                                         FontFamily="{StaticResource ScriptureFont}"
                                                         FontSize="{Binding ReadingFontSize, Source={RelativeSource AncestorType={x:Type vm:ReaderViewModel}}, x:DataType=vm:ReaderViewModel}"
                                                         NumberFontSize="{Binding VerseNumberFontSize, Source={RelativeSource AncestorType={x:Type vm:ReaderViewModel}}, x:DataType=vm:ReaderViewModel}"
                                                         ShowWordsOfJesus="{Binding ShowWordsOfJesus, Source={RelativeSource AncestorType={x:Type vm:ReaderViewModel}}, x:DataType=vm:ReaderViewModel}"
                                                         ShowNumber="{Binding ShowVerseNumbers, Source={RelativeSource AncestorType={x:Type vm:ReaderViewModel}}, x:DataType=vm:ReaderViewModel}"
                                                         LineHeight="{Binding LineSpacing, Source={RelativeSource AncestorType={x:Type vm:ReaderViewModel}}, x:DataType=vm:ReaderViewModel}" />
                                        <!-- Note marker: opens the note -->
                                        <Button Grid.Column="1"
                                                Style="{StaticResource IconButton}"
                                                IsVisible="{Binding ShowsNote}"
                                                Text="&#xE70B;"
                                                FontSize="{Binding NoteMarkerFontSize, Source={RelativeSource AncestorType={x:Type vm:ReaderViewModel}}, x:DataType=vm:ReaderViewModel}"
                                                WidthRequest="{Binding NoteMarkerSize, Source={RelativeSource AncestorType={x:Type vm:ReaderViewModel}}, x:DataType=vm:ReaderViewModel}"
                                                HeightRequest="{Binding NoteMarkerSize, Source={RelativeSource AncestorType={x:Type vm:ReaderViewModel}}, x:DataType=vm:ReaderViewModel}"
                                                TextColor="{DynamicResource AccentColor}"
                                                VerticalOptions="Start"
                                                Margin="8,2,0,0"
                                                Command="{Binding OpenNoteCommand, Source={RelativeSource AncestorType={x:Type vm:ReaderViewModel}}, x:DataType=vm:ReaderViewModel}"
                                                CommandParameter="{Binding .}"
                                                ToolTipProperties.Text="Open note" SemanticProperties.Description="Open note" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Previous / next chapter -->
                    <BoxView HeightRequest="1" Margin="0,48,0,12" Color="{DynamicResource BorderColor}" />
                    <Grid ColumnDefinitions="*,*" IsVisible="{Binding IsChromeVisible}">
                        <Button Style="{StaticResource LinkButton}"
                                Text="{Binding PreviousLabel}"
                                HorizontalOptions="Start"
                                Command="{Binding PreviousChapterCommand}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource LinkButton}"
                                Text="{Binding NextLabel}"
                                HorizontalOptions="End"
                                Command="{Binding NextChapterCommand}" />
                    </Grid>

                    <!-- Attribution required by some licences (e.g. Shona, CC BY-SA) -->
                    <Label Text="{Binding SelectedTranslation.Copyright}"
                           FontSize="12"
                           Margin="0,16,0,0"
                           HorizontalTextAlignment="Center"
                           TextColor="{DynamicResource MutedTextColor}" />
                </VerticalStackLayout>
            </ScrollView>

            <!-- ============ LOADING / ERROR ============ -->
            <ActivityIndicator Grid.Column="1"
                               ZIndex="3"
                               IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               WidthRequest="48"
                               HeightRequest="48"
                               Color="{DynamicResource AccentColor}"
                               SemanticProperties.Description="Loading" />

            <Border Grid.Column="1"
                    ZIndex="6"
                    IsVisible="{Binding HasLoadError}"
                    HorizontalOptions="Center"
                    VerticalOptions="Start"
                    MaximumWidthRequest="560"
                    Margin="16,24,16,0"
                    Padding="20,16"
                    StrokeThickness="1"
                    Stroke="{DynamicResource WordsOfJesusColor}"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{DynamicResource SurfaceColor}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Label Text="&#xE783;"
                           FontFamily="{StaticResource IconFont}"
                           FontSize="20"
                           TextColor="{DynamicResource WordsOfJesusColor}"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding LoadError}" FontSize="15" VerticalOptions="Center" />
                    <Button Grid.Column="2" Style="{StaticResource AccentButton}" Text="Try again" Command="{Binding RetryCommand}" />
                </Grid>
            </Border>

            <!-- ============ VERSE ACTION BAR (when verses are selected) ============ -->
            <Border Grid.Column="1"
                    ZIndex="3"
                    IsVisible="{Binding IsActionBarVisible}"
                    HorizontalOptions="Center"
                    VerticalOptions="End"
                    MaximumWidthRequest="720"
                    Margin="16,0,16,20"
                    Padding="14,10"
                    StrokeThickness="1"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="{DynamicResource SurfaceColor}">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,6" Radius="20" Opacity="0.2" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding SelectionLabel}"
                               FontSize="15"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Style="{StaticResource IconButton}"
                                Text="&#xE711;"
                                Command="{Binding ClearSelectionCommand}"
                                ToolTipProperties.Text="Clear selection (Esc)" SemanticProperties.Description="Clear selection" />
                    </Grid>
                    <FlexLayout Wrap="Wrap" AlignItems="Center" JustifyContent="Start">
                        <!-- Highlight colours -->
                        <HorizontalStackLayout Spacing="6" Margin="0,0,10,6" BindableLayout.ItemsSource="{Binding HighlightSwatches}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:HighlightSwatch">
                                    <Border WidthRequest="30"
                                            HeightRequest="30"
                                            StrokeThickness="1"
                                            Stroke="{DynamicResource BorderColor}"
                                            StrokeShape="Ellipse"
                                            BackgroundColor="{Binding Color}"
                                            ToolTipProperties.Text="{Binding Name}" SemanticProperties.Description="{Binding Name}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding HighlightSelectionCommand, Source={RelativeSource AncestorType={x:Type vm:ReaderViewModel}}, x:DataType=vm:ReaderViewModel}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                        <Button Style="{StaticResource IconButton}"
                                IsVisible="{Binding SelectionHasHighlight}"
                                Text="&#xE75C;"
                                Margin="0,0,10,6"
                                Command="{Binding RemoveHighlightCommand}"
                                ToolTipProperties.Text="Remove highlight" SemanticProperties.Description="Remove highlight" />

                        <HorizontalStackLayout Spacing="6" Margin="0,0,0,6">
                            <Button Style="{StaticResource OutlineButton}" Text="{Binding NoteActionLabel}" Command="{Binding OpenNoteEditorCommand}" />
                            <Button Style="{StaticResource OutlineButton}" Text="Copy" Command="{Binding CopySelectionCommand}" ToolTipProperties.Text="Copy with reference (Ctrl+C)" SemanticProperties.Description="Copy with reference" />
                            <Button Style="{StaticResource OutlineButton}" Text="Share" Command="{Binding ShareSelectionCommand}" />
                            <Button Style="{StaticResource AccentButton}" Text="Present" Command="{Binding PresentSelectionCommand}" ToolTipProperties.Text="Show on the projector from here" SemanticProperties.Description="Show on the projector from here" />
                        </HorizontalStackLayout>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ============ NOTE EDITOR ============ -->
            <!-- A side panel on wide screens, a bottom sheet on phones (placed in code-behind). -->
            <Border x:Name="NoteEditor"
                    Grid.Column="1"
                    ZIndex="4"
                    IsVisible="{Binding IsNoteEditorOpen}"
                    HorizontalOptions="End"
                    VerticalOptions="Fill"
                    WidthRequest="420"
                    Margin="16"
                    Padding="20"
                    StrokeThickness="1"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="{DynamicResource SurfaceColor}">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,6" Radius="24" Opacity="0.22" />
                </Border.Shadow>
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="NOTE" Style="{StaticResource SectionHeaderLabel}" />
                            <Label Text="{Binding NoteReference}" FontSize="18" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Style="{StaticResource IconButton}"
                                Text="&#xE711;"
                                VerticalOptions="Start"
                                Command="{Binding CloseNoteEditorCommand}"
                                ToolTipProperties.Text="Close without saving (Esc)" SemanticProperties.Description="Close without saving" />
                    </Grid>

                    <Label Grid.Row="1"
                           Text="{Binding NotePreview}"
                           FontFamily="{StaticResource ScriptureFont}"
                           FontSize="15"
                           MaxLines="4"
                           LineBreakMode="TailTruncation"
                           TextColor="{DynamicResource MutedTextColor}" />

                    <Border Grid.Row="2"
                            Padding="10,6"
                            StrokeThickness="1"
                            Stroke="{DynamicResource BorderColor}"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="{DynamicResource ChipColor}">
                        <Editor x:Name="NoteEditorText"
                                Text="{Binding NoteText}"
                                Placeholder="Write a thought, a sermon point or a prayer..."
                                PlaceholderColor="{DynamicResource MutedTextColor}"
                                TextColor="{DynamicResource PageTextColor}"
                                BackgroundColor="Transparent"
                                FontFamily="{StaticResource UiFont}"
                                FontSize="16"
                                AutoSize="Disabled" />
                    </Border>

                    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                        <Button Style="{StaticResource LinkButton}"
                                IsVisible="{Binding IsEditingExistingNote}"
                                Text="Delete"
                                TextColor="{DynamicResource WordsOfJesusColor}"
                                Command="{Binding DeleteNoteCommand}" />
                        <Button Grid.Column="2" Style="{StaticResource OutlineButton}" Text="Cancel" Command="{Binding CloseNoteEditorCommand}" />
                        <Button Grid.Column="3" Style="{StaticResource AccentButton}" Text="Save" Command="{Binding SaveNoteCommand}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- ============ STATUS ("Copied John 3:16", "Highlight removed · Undo") ============ -->
            <Border Grid.Column="1"
                    ZIndex="5"
                    IsVisible="{Binding HasStatus}"
                    HorizontalOptions="Center"
                    VerticalOptions="Start"
                    Margin="0,16,0,0"
                    Padding="16,6"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{DynamicResource PageTextColor}">
                <HorizontalStackLayout Spacing="12">
                    <Label Text="{Binding StatusMessage}" FontSize="14" VerticalOptions="Center" TextColor="{DynamicResource PageBackgroundColor}" />
                    <Button IsVisible="{Binding HasStatusAction}"
                            Text="{Binding StatusActionLabel}"
                            Command="{Binding StatusActionCommand}"
                            FontSize="14"
                            FontAttributes="Bold"
                            Padding="10,0"
                            HeightRequest="32"
                            MinimumHeightRequest="32"
                            BorderWidth="0"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource AccentSoftColor}" />
                </HorizontalStackLayout>
            </Border>

            <!-- Projector mode controls: faint until hovered so they don't distract -->
            <Border x:Name="ProjectorControls"
                    Grid.Column="1"
                    IsVisible="{Binding IsProjectorMode}"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="24"
                    Padding="6"
                    Opacity="0.35"
                    StrokeThickness="1"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{DynamicResource SurfaceColor}">
                <Border.GestureRecognizers>
                    <PointerGestureRecognizer PointerEntered="ProjectorControls_PointerEntered"
                                              PointerExited="ProjectorControls_PointerExited" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="2">
                    <Button Style="{StaticResource IconButton}" Text="&#xE76B;" Command="{Binding PreviousChapterCommand}" ToolTipProperties.Text="Previous chapter" SemanticProperties.Description="Previous chapter" />
                    <Button Style="{StaticResource IconButton}" Text="&#xE76C;" Command="{Binding NextChapterCommand}" ToolTipProperties.Text="Next chapter" SemanticProperties.Description="Next chapter" />
                    <Button Style="{StaticResource IconButton}" Text="&#xE8E7;" Command="{Binding DecreaseFontCommand}" ToolTipProperties.Text="Smaller text" SemanticProperties.Description="Smaller text" />
                    <Label Text="{Binding FontSizeLabel}" WidthRequest="56" FontSize="13" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                    <Button Style="{StaticResource IconButton}" Text="&#xE8E8;" Command="{Binding IncreaseFontCommand}" ToolTipProperties.Text="Larger text" SemanticProperties.Description="Larger text" />
                    <Button Style="{StaticResource IconButton}" Text="{Binding ThemeGlyph}" Command="{Binding ToggleThemeCommand}" ToolTipProperties.Text="Light / dark" SemanticProperties.Description="Light / dark" />
                    <Button Style="{StaticResource IconButton}" Text="&#xE73F;" Command="{Binding ExitProjectorCommand}" ToolTipProperties.Text="Exit (Esc)" SemanticProperties.Description="Exit" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- ============ SEARCH DROPDOWN ============ -->
        <!-- Overlays the page under the search box; positioned in code-behind to line up with it. -->
        <Border x:Name="SuggestionsPanel"
                Grid.Row="1"
                IsVisible="{Binding IsSuggestionsOpen}"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                Margin="0,6,0,0"
                Padding="6"
                StrokeThickness="1"
                Stroke="{DynamicResource BorderColor}"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="{DynamicResource SurfaceColor}">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,6" Radius="18" Opacity="0.18" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="2">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Suggestions}" Spacing="2">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:SearchSuggestion">
                            <Border StrokeThickness="0"
                                    Padding="12,8"
                                    StrokeShape="RoundRectangle 8"
                                    BackgroundColor="Transparent">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsHighlighted}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource ChipColor}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenSuggestionCommand, Source={RelativeSource AncestorType={x:Type vm:ReaderViewModel}}, x:DataType=vm:ReaderViewModel}"
                                                          CommandParameter="{Binding .}" />
                                    <PointerGestureRecognizer PointerEntered="Suggestion_PointerEntered"
                                                              PointerExited="Suggestion_PointerExited" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="2">
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Text="&#xE8AD;"
                                               IsVisible="{Binding IsReference}"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="14"
                                               TextColor="{DynamicResource AccentColor}"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding Title}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource PageTextColor}" />
                                    </HorizontalStackLayout>
                                    <comp:HighlightedLabel MarkedText="{Binding HighlightedText}"
                                                           IsVisible="{Binding IsMatch}"
                                                           FontSize="14"
                                                           MaxLines="2"
                                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="No verses match"
                       IsVisible="{Binding HasNoSuggestions}"
                       Padding="12,8"
                       FontSize="14"
                       TextColor="{DynamicResource MutedTextColor}" />

                <BoxView HeightRequest="1" Margin="6,4" Color="{DynamicResource BorderColor}" IsVisible="{Binding HasMoreResults}" />
                <Button Style="{StaticResource LinkButton}"
                        Text="{Binding SeeAllLabel}"
                        IsVisible="{Binding HasMoreResults}"
                        HorizontalOptions="Start"
                        FontSize="14"
                        Command="{Binding SeeAllResultsCommand}" />
            </VerticalStackLayout>
        </Border>

        <!-- ============ DISPLAY MENU ("Aa") ============ -->
        <BoxView Grid.Row="1"
                 IsVisible="{Binding IsDisplayMenuOpen}"
                 Color="Transparent">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseOverlaysCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border Grid.Row="1"
                IsVisible="{Binding IsDisplayMenuOpen}"
                HorizontalOptions="End"
                VerticalOptions="Start"
                WidthRequest="300"
                Margin="0,6,16,0"
                Padding="18,16"
                StrokeThickness="1"
                Stroke="{DynamicResource BorderColor}"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="{DynamicResource SurfaceColor}">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,6" Radius="18" Opacity="0.18" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="14">
                <Label Text="TEXT SIZE" Style="{StaticResource SectionHeaderLabel}" />
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Style="{StaticResource IconButton}" Text="&#xE8E7;" Command="{Binding DecreaseFontCommand}" SemanticProperties.Description="Smaller text" />
                    <Label Grid.Column="1"
                           Text="{Binding FontSizeLabel}"
                           FontSize="15"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ResetFontCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Text="&#xE8E8;" Command="{Binding IncreaseFontCommand}" SemanticProperties.Description="Larger text" />
                </Grid>

                <BoxView HeightRequest="1" Color="{DynamicResource BorderColor}" />

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Dark theme" FontSize="15" VerticalOptions="Center" />
                    <Switch Grid.Column="1"
                            IsToggled="{Binding IsDarkMode}"
                            OnColor="{DynamicResource AccentColor}" />
                </Grid>

                <!-- On a phone the Present button moves here from the toolbar -->
                <Button Style="{StaticResource AccentButton}"
                        IsVisible="{Binding IsNarrow}"
                        Text="Present"
                        Command="{Binding ToggleProjectorCommand}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
